{
  "name": "@paalstack/react-layouts",
  "version": "1.0.1",
  "description": "Polymorphic layout primitives and typography components styled with Tailwind CSS v4",
  "type": "module",
  "types": "dist/index.d.ts",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "author": {
    "name": "Paalamugan",
    "email": "paalamugan@users.noreply.github.com"
  },
  "scripts": {
    "build": "npm run type-check && npm run lint && npm run clean && npm run tsup",
    "lint": "eslint ./src --ext ts,tsx --config ../../.eslintrc.cjs --report-unused-disable-directives --max-warnings 0 --cache",
    "lint:fix": "npm run lint -- --fix",
    "type-check": "tsc --noEmit",
    "format": "prettier --write \"**/*.{ts,tsx,md,mdx}\" --cache",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,mdx}\" --cache",
    "tsup": "tsup",
    "tsup:watch": "tsup --watch",
    "prepublishOnly": "npm run tsup",
    "clean": "rimraf dist",
    "test": "jest --passWithNoTests"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "engines": {
    "node": ">=20.12.x"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/paalamugan/paalstack-react-ui.git"
  },
  "bugs": {
    "url": "https://github.com/paalamugan/paalstack-react-ui/issues"
  },
  "homepage": "https://github.com/paalamugan/paalstack-react-ui#readme",
  "license": "MIT",
  "files": [
    "dist",
    "tsconfig.json"
  ],
  "devDependencies": {
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1"
  }
}
